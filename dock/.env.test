### Postgres DB ###
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpass
POSTGRES_DB=cargosync_dev_db

### Influx DB ###
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=adminpass
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=very-secure-admin-token-indeed
DOCKER_INFLUXDB_INIT_ORG=rs.ac.uns.ftn.nvt.team5
DOCKER_INFLUXDB_INIT_BUCKET=cargosync_dev_bucket

# Core Influx binding (API runs inside docker in test stack)
CARGOSYNC_INFLUX_URL=http://influxdb2:8086
CARGOSYNC_INFLUX_TOKEN=${DOCKER_INFLUXDB_INIT_ADMIN_TOKEN}
CARGOSYNC_INFLUX_ORG=${DOCKER_INFLUXDB_INIT_ORG}
CARGOSYNC_INFLUX_BUCKET=${DOCKER_INFLUXDB_INIT_BUCKET}

### RabbitMq ###
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=adminpass
CARGOSYNC_RABBITMQ_HOST=rabbitmq
CARGOSYNC_RABBITMQ_USERNAME=admin
CARGOSYNC_RABBITMQ_PASSWORD=adminpass

### Core ###
SPRING_PROFILES_ACTIVE=dev
CARGOSYNC_DB_URL=jdbc:postgresql://postgres/cargosync_dev_db
CARGOSYNC_DB_USERNAME=${POSTGRES_USER}
CARGOSYNC_DB_PASSWORD=${POSTGRES_PASSWORD}
CARGOSYNC_AT_SECRET=1511515243123512312341523451243512435142534512435142354125345124354123514235415231253463
CARGOSYNC_MAIL_HOST=mailhog
CARGOSYNC_FRONTEND_URL=http://localhost
CARGOSYNC_CONTENT_ROOT=/app/uploads
CARGOSYNC_MANAGER_PASSWORD_FILE=/app/shared/manager_passwords.txt
CARGOSYNC_REDIS_HOST=redis
CARGOSYNC_REDIS_PORT=6379
